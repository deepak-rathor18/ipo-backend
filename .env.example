# ==============================
# FINTRACK BACKEND - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================

# Server
NODE_ENV=development
PORT=5000

# Frontend (Next.js PWA) origin - used for CORS
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/fintrack

# Auth codes (kept secret, never exposed to clients)
DEEPAK_AUTH_CODE=change-this-deepak-code
AMAN_AUTH_CODE=change-this-aman-code

# JWT / Session secrets - use long random strings in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-this-to-another-long-random-string

# Cookie
COOKIE_NAME=fintrack_token
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
